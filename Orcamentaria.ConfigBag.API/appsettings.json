{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server={{replace}};Port={{replace}};User Id={{replace}};Password={{replace}};Initial Catalog=example-db"
  },
  "ServiceRegistryConfiguration": {
  "BaseUrl": "{{replace}}",
  "Endpoints": [
      {
        "Name": "Register",
        "Route": "/v1/service/register",
        "Method": "POST",
        "RequiredAuthorization": true
      },
      {
        "Name": "Heartbeat",
        "Route": "/v1/service/heartbeat/{serviceId}",
        "Method": "PUT",
        "RequiredAuthorization": true
      }
    ]
  },
  "ApiGetawayConfiguration": {
    "BaseUrl": "{{replace}}",
    "Resources": [
      {
        "ConfigBag": "AuthService",
        "EndpointName": "ServiceAuthenticate",
        "Params": [ "clientId", "clientSecret" ]
      }
    ]
  },
  "ServiceConfiguration": {
    "ConfigBag": "ConfigBag",
    "ClientId": "{{replace}}",
    "ClientSecret": "{{replace}}"
  },
  "AllowedHosts": "*"
}
