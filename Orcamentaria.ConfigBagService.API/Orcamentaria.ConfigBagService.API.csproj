<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
	  <TargetFramework>net9.0</TargetFramework>
	  <Nullable>enable</Nullable>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Keys\public_key_service.pem" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Keys\public_key_service.pem">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Include="Keys\public_key_user.pem">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Orcamentaria.Lib.Application" Version="2.1.3" />
	  <PackageReference Include="Orcamentaria.Lib.Domain" Version="10.0.8" />
	  <PackageReference Include="Orcamentaria.Lib.Infrastructure" Version="5.3.2" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orcamentaria.ConfigBagService.Application\Orcamentaria.ConfigBagService.Application.csproj" />
    <ProjectReference Include="..\Orcamentaria.ConfigBagService.Infrastructure\Orcamentaria.ConfigBagService.Infrastructure.csproj" />
  </ItemGroup>
</Project>